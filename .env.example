# Breeze quant backend - environment template.
# Copy to .env (git-ignored) or run:  python run_pipeline.py --setup-env
# NEVER put real values in this file. It is committed to version control.

# The-Odds-API key (https://the-odds-api.com), 32-char hex.
ODDS_API_KEY=your_odds_api_key_here

# Kalshi API key ID (UUID from Kalshi account settings -> API keys).
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000

# Path to the Kalshi private key PEM (RSA for Kalshi v2 RSA-PSS signing).
# Keep it under keys/ (git-ignored). Market data works without it.
KALSHI_PRIVATE_KEY_PATH=keys/kalshi_private_key.pem

# Fixed baseline bankroll in units. Sizing never compounds P&L into this.
BANKROLL_UNITS=100.0

# Optional overrides
# KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# ODDS_API_BOOKMAKERS=pinnacle,draftkings,fanduel,betmgm,williamhill_us
