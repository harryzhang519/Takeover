# --- Credentials: never commit -------------------------------------------
.env
.env.*
!.env.example
keys/
*.pem
*.key

# --- Local databases and raw data ------------------------------------------
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/raw/

